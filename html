<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Instagram App</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;font-family:Arial,Helvetica,sans-serif}
body{min-height:100vh;background:linear-gradient(135deg,#833ab4,#fd1d1d,#fcb045);display:flex;justify-content:center;align-items:center;color:#fff}
.container{width:92%;max-width:430px;text-align:center}
.card{background:rgba(255,255,255,.13);backdrop-filter:blur(15px);border:1px solid rgba(255,255,255,.3);border-radius:28px;padding:38px 25px;box-shadow:0 20px 50px rgba(0,0,0,.3)}
.logo{width:150px;height:150px;object-fit:cover;border-radius:32px;display:block;margin:0 auto 24px;box-shadow:0 12px 30px rgba(0,0,0,.35)}
h1{font-size:42px;margin-bottom:10px}
.subtitle{font-size:16px;line-height:1.6;opacity:.9;margin-bottom:28px}
.buttons{display:flex;flex-direction:column;gap:14px}
.btn{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;padding:15px;border-radius:14px;text-decoration:none;font-size:16px;font-weight:bold;transition:.25s}
.btn:hover{transform:translateY(-3px);box-shadow:0 8px 20px rgba(0,0,0,.25)}
.instagram{background:#fff;color:#d62976}
.signup{background:rgba(255,255,255,.22);color:#fff;border:1px solid rgba(255,255,255,.35)}
.store{background:#111;color:#fff}
.icon{font-size:21px}
.footer{margin-top:24px;font-size:12px;opacity:.7}
@media(max-width:480px){h1{font-size:36px}.logo{width:130px;height:130px}.card{padding:32px 20px}}
</style>
</head>
<body>
<div class="container">
<div class="card">

<img class="logo" src="data:image/png;base64," alt="Instagram logo">

<h1>Instagram</h1>

<p class="subtitle">
Share photos, videos and moments with the people you love.
</p>

<div class="buttons">

<a class="btn instagram"
href="https://www.instagram.com/"
target="_blank"
rel="noopener noreferrer">
<span class="icon">📸</span>
Open Instagram
</a>

<a class="btn signup"
href="https://www.instagram.com/accounts/signup/phone/"
target="_blank"
rel="noopener noreferrer">
<span class="icon">✨</span>
Sign up for Instagram
</a>

<a class="btn store"
href="https://play.google.com/store/games?hl=en"
target="_blank"
rel="noopener noreferrer">
<span class="icon">▶</span>
Get it on Google Play
</a>

<a class="btn store"
href="https://www.apple.com/jp/app-store/"
target="_blank"
rel="noopener noreferrer">
<span class="icon"></span>
Download on the App Store
</a>

</div>

<div class="footer">
Instagram-style app landing page
</div>

</div>
</div>
</body>
</html>
